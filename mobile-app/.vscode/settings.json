{
  "cSpell.words": [
    "appbar",
    "Butiran",
    "cupertino",
    "dartz",
    "Directus",
    "geolocator",
    "Meteo",
    "Nominatim",
    "openmeteo",
    "Perbarui",
    "petanitech",
    "prefs",
    "pubspec",
    "Schyler"
  ],
  "cSpell.language": "en,id,id-ID",
  "editor.rulers": [120],
  "[dart]": {
    "editor.rulers": [120]
  },
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  // "editor.fontFamily": "Consolas",
  "editor.fontSize": 12,
  "editor.lineHeight": 1.5,
  "editor.letterSpacing": 0.5,
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "indent",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.autoIndent": "full",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.bracketPairColorization.enabled": true,
  "workbench.colorTheme": "Dark+",
  "workbench.iconTheme": "material-icon-theme",
  // "files.autoSave": "afterDelay",
  // "files.autoSaveDelay": 1000
  "files.exclude": {
    "**/.git": false,
    "**/.svn": false,
    "**/.hg": false,
    "**/.DS_Store": false,
    "**/.flutter-plugins": false,
    "**/.flutter-plugins-dependencies": false,
    "**/pubspec.lock": false,
    "**/analysis_options.yaml": false,
    "**/.metadata": false,
    "**/Thumbs.db": false,
    "**/node_modules": false,
    "**/android": false,
    "**/ios": false,
    "**/build": false,
    "**/dist": false,
    "**/linux": false,
    "**/web": false,
    "**/windows": false,
    "**/macos": false,
    "**/.idea": false,
    "**/.dart_tool": false,
    "**/**.iml": false,
    "**/.**": false
  }
}
